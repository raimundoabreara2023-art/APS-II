<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" alignment="CENTER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lagoa.controller.DuckSimulatorController" prefWidth="600.0" prefHeight="450.0">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <!-- Título da Aplicação -->
    <Label text="🦆 Simulador de Patos - SimUDuck (Padrão Strategy)">
        <font>
            <Font name="System Bold" size="18.0"/>
        </font>
    </Label>

    <!-- Seleção de Pato -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Selecione um Pato:"/>
        <ComboBox fx:id="comboPatos" prefWidth="220.0" onAction="#handlePatoSelecionado"/>
    </HBox>

    <!-- Botões de Ação Básicos -->
    <HBox spacing="10.0" alignment="CENTER">
        <Button text="Apresentar (display)" onAction="#handleDisplay"/>
        <Button text="Voar (performFly)" onAction="#handlePerformFly"/>
        <Button text="Emitir Som (performQuack)" onAction="#handlePerformQuack"/>
        <Button text="Nadar (swim)" onAction="#handleSwim"/>
    </HBox>

    <!-- Alteração Dinâmica de Comportamento (Strategy em Ação) -->
    <HBox spacing="10.0" alignment="CENTER">
        <Button text="🚀 Equipar Foguete no Voo" onAction="#handleEquiparFoguete"/>
        <Button text="🔇 Mutar Pato" onAction="#handleMutarPato"/>
    </HBox>

    <!-- Console de Saída -->
    <VBox spacing="5.0" VBox.vgrow="ALWAYS">
        <Label text="Saída / Console:"/>
        <TextArea fx:id="txtConsole" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
    </VBox>

</VBox>