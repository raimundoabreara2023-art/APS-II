<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" 
      stylesheets="@Estilo.css" 
      xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="br.com.aula_3.visao.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="lblTitulo" text="Sistema de Veículos e Pista" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
    
    <!-- Novo rótulo para exibir a pista -->
    <Label fx:id="lblPista" text="Carregando pista..." style="-fx-font-style: italic; -fx-text-fill: #7f8c8d;" />

    <Button fx:id="btnAcelerarCarro" text="Acelerar Carro na Pista" onAction="#onAcelerarCarroClick" />
    
    <Button fx:id="btnAcelerarBici" text="Acelerar Bicicleta na Pista" onAction="#onAcelerarBicicletaClick" />

    <Label fx:id="lblResultado" text="Clique em um botão para testar..." />
</VBox>